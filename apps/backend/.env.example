DATABASE_URL=postgresql+psycopg://rebook:rebook_dev@127.0.0.1:5432/rebook
DATABASE_URL_TEST=postgresql+psycopg://rebook:rebook_dev@127.0.0.1:5432/rebook_test
SESSION_SECRET=change_me_to_random_string
# Токен бота CRM (НЕ токен legacy демо-бота — polling-конфликт)
TELEGRAM_BOT_TOKEN=
# Салон, который обслуживает бот в dev (по умолчанию — первый с токеном)
BOT_SALON_ID=
# LLM-ассистент: запись и вопросы свободным текстом. Пусто — только кнопки.
# Любой OpenAI-совместимый endpoint (OpenRouter по умолчанию)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash
