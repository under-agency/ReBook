# Скрипты и конфиги исполняются на Ubuntu: CRLF ломает шебанг
# (`bad interpreter: /usr/bin/env bash^M`), поэтому только LF.
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile      text eol=lf
Caddyfile       text eol=lf
*.env.example   text eol=lf

*.py            text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.json          text eol=lf
*.md            text eol=lf

*.png binary
*.jpg binary
*.ico binary
