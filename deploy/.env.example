# Домен кабинета — на него Caddy выпустит сертификат Let's Encrypt.
# Оставьте пустым, пока домена нет: сайт будет по IP на http://<ip>/ без TLS.
DOMAIN=

# Пароль базы и ключ подписи сессий: сгенерируйте, например `openssl rand -hex 32`
DB_PASSWORD=
SESSION_SECRET=

# Токен бота CRM (@BotFather). Токены салонов задаются в админке.
TELEGRAM_BOT_TOKEN=
BOT_SALON_ID=

# ИИ-ассистент бота (свободный текст). Пусто — только кнопки.
# Любой OpenAI-совместимый endpoint, по умолчанию OpenRouter
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash
